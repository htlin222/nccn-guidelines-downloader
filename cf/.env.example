# Copy to `.env` (it is gitignored) and paste your token.
# Used by gen_versions.sh / seed_r2.sh / gen_thumbs.sh for wrangler auth, and
# it is the SAME token you put in the GitHub Actions secret CLOUDFLARE_API_TOKEN.
#
# Create the token at https://dash.cloudflare.com/profile/api-tokens
#   Permissions: Account → Workers R2 Storage → Edit
#   (add Account → Workers Scripts → Edit too if you also want `wrangler deploy`)

CLOUDFLARE_API_TOKEN=paste-your-token-here
CLOUDFLARE_ACCOUNT_ID=3a77813251d473c40d8873a59f6c0e80
