{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nccn-download",
  "main": "src/index.js",
  "compatibility_date": "2025-07-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // Workers AI 免費額度是 10,000 neurons/day（UTC 00:00 重置），留餘裕。
    "AI_DAILY_NEURONS": "8000"
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    {
      "binding": "NCCN_KV",
      "id": "f1c25d8c3a604b3c9fb56d4ddc5f24bb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "nccn-pdfs"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nccn-search",
      "database_id": "5af203fd-a38e-4a92-9c44-0c20bfc952f6"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "routes": [
    {
      "pattern": "nccn.hsiehting.com",
      "custom_domain": true
    }
  ]
}
