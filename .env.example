# Lives at the repo root (NCCN/.env), NOT in cf/. Every helper script sources it
# as ../.env after cd'ing into cf/, so `bash deploy.sh` / `bash gen_clean.sh` etc.
# just work.
#
# Caveat: wrangler only auto-loads a .env sitting next to wrangler.jsonc, which
# this one is not. Before running wrangler BY HAND, source it yourself:
#     cd cf && set -a; . ../.env; set +a
# Otherwise you get "Invalid access token" / "Authentication error [code: 10000]".
#
# Copy to `.env` (it is gitignored) and paste your token:
#     cp .env.example .env && $EDITOR .env
#
# Used by every helper script (gen_versions.sh / gen_thumbs.sh / build_index.sh /
# build_toc.sh / gen_clean.sh / seed_r2.sh) AND by deploy.sh, and it is the SAME
# token you store as the GitHub Actions secret CLOUDFLARE_API_TOKEN.
#
# Create it at https://dash.cloudflare.com/profile/api-tokens
#   → Create Token → use the "Edit Cloudflare Workers" template, which already
#     grants Workers Scripts:Edit, Workers KV Storage:Edit, Workers R2
#     Storage:Edit, D1:Edit, Workers Routes:Edit, Zone:Read.
#   → then ADD one more permission the template does not include:
#         Account → Workers AI → Edit      (needed by the env.AI binding)
#   → Account Resources: include this account.
#
# Why a token and not `wrangler login`: OAuth credentials get revoked and then
# deploys fail with a bare "Invalid access token". A scoped token does not.
#
# If you roll this token, update BOTH cf/.env and the GitHub Actions secret —
# the weekly workflow authenticates with the same value.

CLOUDFLARE_API_TOKEN=paste-your-token-here
CLOUDFLARE_ACCOUNT_ID=3a77813251d473c40d8873a59f6c0e80
